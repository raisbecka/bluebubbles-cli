def cmd_chats_delete(ctx, a):
    out(api(ctx, "DELETE", f"/chat/{urllib.parse.quote(a.guid)}"), a.compact)


# --- messages

def cmd_messages_send(ctx, a):
    chat_guid = address_to_guid(a.chat)
    if a.attach:
        if a.dry_run:
            out({"dryRun": True, "action": "send-multipart", "chatGuid": chat_guid,
                 "text": a.text, "attachments": a.attach}, a.compact)
            return
        for path in a.attach:
            if not os.path.exists(path):
                die(f"attachment not found: {path}", 2)
        # upload each file, then send multipart (text + attachments)
        parts = []
        if a.text:
            parts.append({"partIndex": 0, "text": a.text})
        idx = 1 if a.text else 0
        for path in a.attach:
            with open(path, "rb") as f:
                body, ctype = multipart([], [("attachment", os.path.basename(path), f.read())])
            status, data = http(ctx, "POST", API + "/attachment/upload",
                                raw_body=body, content_type=ctype)
            if status >= 400:
                die(f"upload failed ({status}): {data}")
            att = data.get("data", {}).get("attachment") or data.get("data")
            att_guid = att.get("guid") if isinstance(att, dict) else att
            if not att_guid:
                die(f"upload did not return a guid: {data}")
            parts.append({"partIndex": idx, "attachment": att_guid,
                          "name": os.path.basename(path)})
            idx += 1
        body = {"chatGuid": chat_guid, "parts": parts}
        if a.effect:
            body["effectId"] = a.effect
        out(api(ctx, "POST", "/message/multipart", body=body), a.compact)
        return

    body = {"chatGuid": chat_guid, "tempGuid": str(uuid.uuid4()), "message": a.text,
            "method": a.method}
    if a.effect:
        body["effectId"] = a.effect
    if a.reply_to:
        body["selectedMessageGuid"] = a.reply_to
    if a.dry_run:
        out({"dryRun": True, "action": "send-text", "body": body}, a.compact)
        return
    out(api(ctx, "POST", "/message/text", body=body), a.compact)


def resolve_chat_guid(ctx, addr):
    """Resolve an address to the real chat GUID from the server DB."""
    data = api(ctx, "POST", "/handle/query",
               body={"limit": 5, "offset": 0, "with": ["chat", "chat.participants"],
                     "address": addr})
    for h in data.get("data", []):
        # server nests the chat(s) under a "chats" list
        chats = h.get("chats")
        if isinstance(chats, list):
            for chat in chats:
                if isinstance(chat, dict) and chat.get("guid"):
                    return chat["guid"]
        chat = h.get("chat")
        if isinstance(chat, dict) and chat.get("guid"):
            return chat["guid"]
    return address_to_guid(addr)


def cmd_messages_list(ctx, a):
    body = {"limit": a.limit, "offset": a.offset, "sort": a.sort,
            "with": ["chat", "chat.participants", "attachment", "handle", "sms"]}
    if a.chat:
        body["chatGuid"] = resolve_chat_guid(ctx, a.chat)
    out(api(ctx, "POST", "/message/query", body=body), a.compact)


def cmd_messages_search(ctx, a):
    body = {"limit": a.limit, "offset": 0, "sort": "DESC",
            "with": ["chat", "attachment", "handle"],
            "where": [{"statement": "message.text LIKE :q", "args": {"q": f"%{a.text}%"}}]}
    out(api(ctx, "POST", "/message/query", body=body), a.compact)


def cmd_messages_get(ctx, a):
    data = api(ctx, "GET", f"/message/{urllib.parse.quote(a.guid)}",
               params={"with": "chats,participants,attachment,handle"})
    out(data, a.compact)


def cmd_messages_react(ctx, a):
    body = {"chatGuid": address_to_guid(a.chat), "selectedMessageGuid": a.message,
            "reaction": a.reaction}
    if a.part_index is not None:
        body["partIndex"] = a.part_index
    out(api(ctx, "POST", "/message/react", body=body), a.compact)


def cmd_messages_edit(ctx, a):
    body = {"editedMessage": a.text, "backwardsCompatibilityMessage": f"Edited to “{a.text}”"}
    if a.part_index is not None:
        body["partIndex"] = a.part_index
    out(api(ctx, "POST", f"/message/{urllib.parse.quote(a.guid)}/edit", body=body), a.compact)


def cmd_messages_unsend(ctx, a):
    body = {}
    if a.part_index is not None:
        body["partIndex"] = a.part_index
    out(api(ctx, "POST", f"/message/{urllib.parse.quote(a.guid)}/unsend", body=body), a.compact)


# --- attachments

def cmd_attach_download(ctx, a):
    dest = a.output
    if not dest:
        status, meta = http(ctx, "GET", API + f"/attachment/{urllib.parse.quote(a.guid)}")
        if status >= 400:
            die(f"cannot fetch attachment metadata: {meta}")
        att = meta.get("data", {}).get("attachment", {})
        name = att.get("fileName") or att.get("name") or a.guid
        dest = os.path.basename(str(name))
    status, payload = http(ctx, "GET", API + f"/attachment/{urllib.parse.quote(a.guid)}/download",
                           binary=True)
    if status >= 400:
        die(f"download failed ({status}): {str(payload)[:300]}")
    with open(dest, "wb") as f:
        f.write(payload)
    out({"saved": os.path.abspath(dest), "bytes": len(payload)}, a.compact)


def cmd_attach_send(ctx, a):
    if not os.path.exists(a.file):
        die(f"file not found: {a.file}", 2)
    if a.dry_run:
        out({"dryRun": True, "action": "send-attachment",
             "chatGuid": address_to_guid(a.chat), "file": a.file}, a.compact)
        return
    with open(a.file, "rb") as f:
        content = f.read()
    fields = [("chatGuid", address_to_guid(a.chat)), ("tempGuid", str(uuid.uuid4())),
              ("name", os.path.basename(a.file)),
              ("method", a.method or "apple-script")]
    body, ctype = multipart(fields, [("attachment", os.path.basename(a.file), content)])
    status, data = http(ctx, "POST", API + "/message/attachment",
                        raw_body=body, content_type=ctype)
    if status >= 400:
        die(f"send failed ({status}): {data}")
    out(data, a.compact)


# --- contacts

def cmd_contacts_list(ctx, a):
    data = api(ctx, "GET", "/contact")
    payload = data.get("data")
    if isinstance(payload, dict):
        contacts = payload.get("contacts", [])
    elif isinstance(payload, list):
        contacts = payload
    else:
        contacts = []
    if isinstance(contacts, dict):
        contacts = list(contacts.values())
    if a.search:
        q = a.search.lower()
        contacts = [c for c in contacts
                    if q in json.dumps(c, ensure_ascii=False).lower()]
    if a.limit:
        contacts = contacts[:a.limit]
    out({"count": len(contacts), "contacts": contacts}, a.compact)


def cmd_contacts_get(ctx, a):
    data = api(ctx, "GET", "/icloud/contact", params={"address": a.address})
    out(data, a.compact)


def cmd_contacts_query(ctx, a):
    out(api(ctx, "POST", "/contact/query", body={"addresses": a.addresses}), a.compact)


