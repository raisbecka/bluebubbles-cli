# --- escape hatch

def cmd_raw(ctx, a):
    params = {}
    for kv in a.params or []:
        k, _, v = kv.partition("=")
        params[k] = v
    out(api(ctx, a.method.upper(), a.path, params=params,
            body=json.loads(a.body) if a.body else None), a.compact)


# ---------------------------------------------------------------- parser

def build_parser():
    p = argparse.ArgumentParser(
        prog="bub",
        description="BlueBubbles Server REST API CLI (JSON out, stdlib-only).")
    p.add_argument("--host", help="server host (default: BLUEBUBBLES_HOST or 127.0.0.1)")
    p.add_argument("--port", help="server port (default: BLUEBUBBLES_PORT or 1234)")
    p.add_argument("--scheme", help="http or https (default: BLUEBUBBLES_SCHEME or http)")
    p.add_argument("--password", help="API password (default: BLUEBUBBLES_PASSWORD)")
    p.add_argument("--compact", action="store_true", help="single-line JSON output")
    sub = p.add_subparsers(dest="cmd", required=True)

    for name, fn, help_ in [
        ("ping", cmd_ping, "health check"),
        ("info", cmd_info, "server metadata (version, iMessage account, etc)"),
        ("stats", cmd_stats, "iMessage entity totals"),
        ("logs", cmd_logs, "server logs"),
        ("alerts", cmd_alerts, "server alerts"),
        ("update-check", cmd_update_check, "check for server updates"),
    ]:
        sp = sub.add_parser(name, help=help_)
        sp.set_defaults(fn=fn)

    # chats
    c = sub.add_parser("chats", help="chat operations").add_subparsers(dest="sub", required=True)

    sp = c.add_parser("list", help="list chats (query, paginated)")
    sp.add_argument("--limit", type=int, default=100)
    sp.add_argument("--offset", type=int, default=0)
    sp.add_argument("--sort", default="lastmessage")
    sp.set_defaults(fn=cmd_chats_list)

    sp = c.add_parser("get", help="get chat by GUID")
    sp.add_argument("guid")
    sp.add_argument("--with", dest="with_", default=None,
                    help="e.g. participants,lastmessage")
    sp.set_defaults(fn=cmd_chats_get)

    sp = c.add_parser("messages", help="all messages in a chat")
    sp.add_argument("guid")
    sp.add_argument("--with", dest="with_", default=None)
    sp.set_defaults(fn=cmd_chats_messages)

    sp = c.add_parser("search", help="search chats by display name")
    sp.add_argument("text")
    sp.add_argument("--limit", type=int, default=50)
    sp.set_defaults(fn=cmd_chats_search)

    sp = c.add_parser("new", help="start a new chat (optionally with a message)")
    sp.add_argument("addresses", nargs="+", help="phone numbers / emails / chat GUIDs")
    sp.add_argument("--message", default=None)
    sp.set_defaults(fn=cmd_chats_new)

    sp = c.add_parser("rename", help="set a chat's display name")
    sp.add_argument("guid")
    sp.add_argument("name")
    sp.set_defaults(fn=cmd_chats_rename)

    sp = c.add_parser("add-participant", help="add a participant to a group chat")
    sp.add_argument("guid")
    sp.add_argument("address")
    sp.set_defaults(fn=cmd_chats_add_participant)

    sp = c.add_parser("remove-participant", help="remove a participant from a group chat")
    sp.add_argument("guid")
    sp.add_argument("address")
    sp.set_defaults(fn=cmd_chats_remove_participant)

    sp = c.add_parser("delete", help="delete a chat")
    sp.add_argument("guid")
    sp.set_defaults(fn=cmd_chats_delete)

    # messages
    m = sub.add_parser("messages", help="message operations").add_subparsers(dest="sub", required=True)

    sp = m.add_parser("send", help="send a text (and optional attachments)")
    sp.add_argument("chat", help="chat GUID, phone number, or email")
    sp.add_argument("text", nargs="?", default="", help="message text")
    sp.add_argument("--attach", nargs="*", default=[], help="file(s) to send with the text")
    sp.add_argument("--effect", default=None, help="effect ID (e.g. com.apple.effect.symbols-balloon)")
    sp.add_argument("--reply-to", default=None, help="message GUID to reply to (needs private API)")
    sp.add_argument("--method", default="apple-script", choices=["apple-script", "private-api"])
    sp.add_argument("--dry-run", action="store_true", help="print the payload, send nothing")
    sp.set_defaults(fn=cmd_messages_send)

    sp = m.add_parser("list", help="recent messages (query, paginated)")
    sp.add_argument("--limit", type=int, default=20)
    sp.add_argument("--offset", type=int, default=0)
    sp.add_argument("--sort", default="DESC")
    sp.add_argument("--chat", default=None, help="restrict to one chat GUID/number/email")
    sp.set_defaults(fn=cmd_messages_list)

    sp = m.add_parser("search", help="search message text (LIKE)")
    sp.add_argument("text")
    sp.add_argument("--limit", type=int, default=50)
    sp.set_defaults(fn=cmd_messages_search)

    sp = m.add_parser("get", help="get a message by GUID")
    sp.add_argument("guid")
    sp.set_defaults(fn=cmd_messages_get)

    sp = m.add_parser("react", help="react to a message (emoji)")
    sp.add_argument("chat", help="chat GUID/number/email")
    sp.add_argument("message", help="GUID of the message to react to")
    sp.add_argument("reaction", help="e.g. ❤️, 👍, 😂")
    sp.add_argument("--part-index", type=int, default=None)
    sp.set_defaults(fn=cmd_messages_react)

    sp = m.add_parser("edit", help="edit a message (needs private API)")
    sp.add_argument("guid")
    sp.add_argument("text")
    sp.add_argument("--part-index", type=int, default=None)
    sp.set_defaults(fn=cmd_messages_edit)

    sp = m.add_parser("unsend", help="unsend a message (needs private API)")
    sp.add_argument("guid")
    sp.add_argument("--part-index", type=int, default=None)
    sp.set_defaults(fn=cmd_messages_unsend)

    # attachments
    at = sub.add_parser("attach", help="attachment operations").add_subparsers(dest="sub", required=True)

    sp = at.add_parser("download", help="download an attachment to a file")
    sp.add_argument("guid")
    sp.add_argument("-o", "--output", default=None, help="destination path")
    sp.set_defaults(fn=cmd_attach_download)

    sp = at.add_parser("send", help="send a file as an attachment")
    sp.add_argument("chat", help="chat GUID/number/email")
    sp.add_argument("file")
    sp.add_argument("--method", default=None)
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(fn=cmd_attach_send)

    # contacts
    ct = sub.add_parser("contacts", help="macOS Contacts via the server").add_subparsers(dest="sub", required=True)

    sp = ct.add_parser("list", help="list contacts (client-side filter)")
    sp.add_argument("--search", default=None, help="substring match on any field")
    sp.add_argument("--limit", type=int, default=None)
    sp.set_defaults(fn=cmd_contacts_list)

    sp = ct.add_parser("get", help="get an iCloud contact card by address")
    sp.add_argument("address")
    sp.set_defaults(fn=cmd_contacts_get)

    sp = ct.add_parser("query", help="query contacts by exact addresses")
    sp.add_argument("addresses", nargs="+")
    sp.set_defaults(fn=cmd_contacts_query)

    # handles
    h = sub.add_parser("handles", help="iMessage handle operations").add_subparsers(dest="sub", required=True)

    sp = h.add_parser("get", help="get a handle by address")
    sp.add_argument("address")
    sp.set_defaults(fn=cmd_handles_get)

    sp = h.add_parser("availability", help="iMessage/FaceTime availability")
    sp.add_argument("address")
    sp.add_argument("--kind", default="imessage", choices=["imessage", "facetime"])
    sp.set_defaults(fn=cmd_handles_availability)

    sp = h.add_parser("query", help="query handles")
    sp.add_argument("--address", default=None)
    sp.add_argument("--limit", type=int, default=100)
    sp.set_defaults(fn=cmd_handles_query)

    # scheduled messages
    s = sub.add_parser("schedule", help="scheduled messages").add_subparsers(dest="sub", required=True)

    s.add_parser("list", help="list scheduled messages").set_defaults(fn=cmd_schedule_list)

    sp = s.add_parser("get", help="get scheduled message by ID")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_schedule_get)

    sp = s.add_parser("create", help="schedule a message")
    sp.add_argument("chat", help="chat GUID/number/email")
    sp.add_argument("text")
    sp.add_argument("--at", required=True, help="'YYYY-MM-DD HH:MM' or epoch seconds")
    sp.add_argument("--method", default="apple-script", choices=["apple-script", "private-api"])
    sp.set_defaults(fn=cmd_schedule_create)

    sp = s.add_parser("update", help="reschedule a message")
    sp.add_argument("id")
    sp.add_argument("--at", required=True)
    sp.set_defaults(fn=cmd_schedule_update)

    sp = s.add_parser("delete", help="cancel a scheduled message")
    sp.add_argument("id")
    sp.set_defaults(fn=cmd_schedule_delete)

    # find my
    f = sub.add_parser("findmy", help="Find My (devices/friends)").add_subparsers(dest="sub", required=True)
    f.add_parser("devices", help="my device locations").set_defaults(fn=cmd_findmy_devices)
    f.add_parser("friends", help="friends' locations").set_defaults(fn=cmd_findmy_friends)

    # raw escape hatch
    sp = sub.add_parser("raw", help="raw API call: bub raw GET /api/v1/ping")
    sp.add_argument("method")
    sp.add_argument("path", help="e.g. /api/v1/server/info")
    sp.add_argument("--param", dest="params", action="append", help="k=v query params (repeatable)")
    sp.add_argument("--body", default=None, help="JSON request body")
    sp.set_defaults(fn=cmd_raw)

    return p


def main():
    args = build_parser().parse_args()
    ctx = Ctx(args)
    args.fn(ctx, args)


if __name__ == "__main__":
    main()
