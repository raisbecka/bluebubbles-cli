#!/usr/bin/env python3
"""
bub — CLI for the BlueBubbles Server REST API.

Stdlib-only (no pip deps) so it runs anywhere Python 3.8+ does,
including a bare docker container.

Config resolution (first wins):
  1. CLI flags:  --host --port --scheme --password
  2. Env vars:   BLUEBUBBLES_HOST BLUEBUBBLES_PORT BLUEBUBBLES_SCHEME BLUEBUBBLES_PASSWORD
  3. Config file: $BUB_CONFIG, ~/.config/bub/config.json, ~/.bubrc
     {"host": "127.0.0.1", "port": "1234", "scheme": "http", "password": "..."}

Output: pretty JSON on stdout by default; --compact for single-line.
Exit codes: 0 ok, 1 API error, 2 usage/config error.
"""

import argparse
import io
import json
import mimetypes
import os
import socket
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime

API = "/api/v1"


# ---------------------------------------------------------------- config

def load_config_file():
    candidates = [
        os.environ.get("BUB_CONFIG"),
        os.path.expanduser("~/.config/bub/config.json"),
        os.path.expanduser("~/.bubrc"),
    ]
    for path in candidates:
        if path and os.path.exists(path):
            try:
                with open(path) as f:
                    return json.load(f)
            except (json.JSONDecodeError, OSError) as e:
                die(f"bad config file {path}: {e}", 2)
    return {}


class Ctx:
    def __init__(self, args):
        cfg = load_config_file()
        self.host = args.host or os.environ.get("BLUEBUBBLES_HOST") or cfg.get("host") or "127.0.0.1"
        self.port = str(args.port or os.environ.get("BLUEBUBBLES_PORT") or cfg.get("port") or "1234")
        self.scheme = (args.scheme or os.environ.get("BLUEBUBBLES_SCHEME") or cfg.get("scheme") or "http").rstrip("/")
        self.password = args.password or os.environ.get("BLUEBUBBLES_PASSWORD") or cfg.get("password")
        if not self.password:
            die("no API password: use --password, BLUEBUBBLES_PASSWORD, or a config file", 2)
        self.base = f"{self.scheme}://{self.host}:{self.port}"


def die(msg, code=1):
    print(f"bub: {msg}", file=sys.stderr)
    sys.exit(code)


def out(data, compact):
    text = json.dumps(data, indent=None if compact else 2, ensure_ascii=False, default=str)
    print(text)


# ---------------------------------------------------------------- http

def http(ctx, method, path, params=None, body=None, headers=None, raw_body=None,
         content_type=None, binary=False):
    """Perform an API request. Returns (status, parsed-or-bytes)."""
    timeout = int(os.environ.get("BUB_TIMEOUT", "300"))
    q = {"password": ctx.password}
    if params:
        q.update({k: v for k, v in params.items() if v is not None})
    url = ctx.base + path + ("?" + urllib.parse.urlencode(q) if q else "")

    if raw_body is not None:
        data = raw_body
    elif body is not None:
        data = json.dumps(body).encode()
        content_type = "application/json"
    else:
        data = None

    req = urllib.request.Request(url, data=data, method=method)
    if content_type:
        req.add_header("Content-Type", content_type)
    for k, v in (headers or {}).items():
        req.add_header(k, v)

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            payload = resp.read()
            status = resp.status
    except urllib.error.HTTPError as e:
        payload = e.read()
        status = e.code
    except urllib.error.URLError as e:
        die(f"cannot reach {ctx.base}: {e.reason}", 2)
    except (socket.timeout, TimeoutError) as e:
        die(f"timed out after {timeout}s on {method} {path} — the server is still "
            f"working (AppleScript sends can be slow); the message may have gone through", 2)

    if binary:
        return status, payload
    try:
        return status, json.loads(payload.decode("utf-8", "replace"))
    except json.JSONDecodeError:
        return status, payload.decode("utf-8", "replace")


def api(ctx, method, path, **kw):
    status, data = http(ctx, method, API + path, **kw)
    if status >= 400:
        if isinstance(data, dict):
            err = data.get("error")
            if isinstance(err, dict) and err.get("message"):
                msg = f"{data.get('message', '')} ({err['message']})"
            else:
                msg = data.get("message") or json.dumps(data)
        else:
            msg = str(data)[:500]
        die(f"API {status} on {method} {path}: {msg}")
    return data


def multipart(fields, files):
    """Build a multipart/form-data body. fields: list[(name, value)],
    files: list[(name, filename, bytes)]. Returns (body_bytes, content_type)."""
    boundary = uuid.uuid4().hex
    buf = io.BytesIO()
    for name, value in fields:
        buf.write(f"--{boundary}\r\n".encode())
        buf.write(f'Content-Disposition: form-data; name="{name}"\r\n\r\n'.encode())
        buf.write(f"{value}\r\n".encode())
    for name, filename, content in files:
        ctype = mimetypes.guess_type(filename)[0] or "application/octet-stream"
        buf.write(f"--{boundary}\r\n".encode())
        buf.write(f'Content-Disposition: form-data; name="{name}"; filename="{filename}"\r\n'.encode())
        buf.write(f"Content-Type: {ctype}\r\n\r\n".encode())
        buf.write(content)
        buf.write(b"\r\n")
    buf.write(f"--{boundary}--\r\n".encode())
    return buf.getvalue(), f"multipart/form-data; boundary={boundary}"


# ---------------------------------------------------------------- helpers

def address_to_guid(addr):
    """Turn a phone/email into a 1:1 chat GUID; pass through existing GUIDs."""
    if ";" in addr:
        return addr
    if addr.startswith("+") or any(c.isdigit() for c in addr):
        return f"iMessage;+;{addr.lstrip('+')}"
    return f"iMessage;-;{addr}"


def parse_when(s):
    """Parse a local time string to epoch milliseconds."""
    s = s.strip()
    if s.isdigit():
        v = int(s)
        return v if v > 10_000_000_000 else v * 1000  # seconds vs ms
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return int(datetime.strptime(s, fmt).timestamp() * 1000)
        except ValueError:
            pass
    die(f"cannot parse time {s!r} (use e.g. '2026-10-13 09:30' or epoch seconds)", 2)


def ts(ms):
    if isinstance(ms, (int, float)):
        return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M:%S")
    return ms


