def cmd_chats_list(ctx, a):
    body = {"limit": a.limit, "offset": a.offset, "sort": a.sort,
            "with": ["lastMessage", "sms", "archived"]}
    data = api(ctx, "POST", "/chat/query", body=body)
    out(data, a.compact)


def cmd_chats_get(ctx, a):
    data = api(ctx, "GET", f"/chat/{urllib.parse.quote(a.guid)}",
               params={"with": a.with_ or "participants,lastmessage"})
    out(data, a.compact)


def cmd_chats_messages(ctx, a):
    data = api(ctx, "GET", f"/chat/{urllib.parse.quote(a.guid)}/message",
               params={"with": a.with_ or "participants,attachment,handle"})
    out(data, a.compact)


def cmd_chats_search(ctx, a):
    body = {"limit": a.limit, "offset": 0, "sort": "lastmessage",
            "with": ["lastMessage", "participants"],
            "where": [{"statement": "chat.displayName LIKE :q", "args": {"q": f"%{a.text}%"}}]}
    out(api(ctx, "POST", "/chat/query", body=body), a.compact)


def cmd_chats_new(ctx, a):
    body = {"addresses": [address_to_guid(x) for x in a.addresses]}
    if a.message:
        body["message"] = a.message
    out(api(ctx, "POST", "/chat/new", body=body), a.compact)


def cmd_chats_rename(ctx, a):
